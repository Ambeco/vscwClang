set(CMAKE_SYSTEM_NAME WASI)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
foreach(L C CXX)
  set(CMAKE_${L}_COMPILER_FORCED TRUE)
  set(CMAKE_${L}_COMPILER_ID Clang)
  set(CMAKE_${L}_COMPILER_ID_RUN 1)
  set(CMAKE_${L}_COMPILER_VERSION 24.0.0)
  set(CMAKE_${L}_FRONTEND_VARIANT GNU)
  set(CMAKE_${L}_COMPILER_WORKS TRUE)
  set(CMAKE_${L}_COMPILER_ID_RUN TRUE)
endforeach()
set(CMAKE_C_COMPILER ${CMAKE_CURRENT_LIST_DIR}/cc.cmd)
set(CMAKE_CXX_COMPILER ${CMAKE_CURRENT_LIST_DIR}/c++.cmd)
set(CMAKE_AR ${CMAKE_CURRENT_LIST_DIR}/ar.cmd)
set(CMAKE_RANLIB ${CMAKE_CURRENT_LIST_DIR}/ar.cmd)
set(CMAKE_C_STANDARD_COMPUTED_DEFAULT 17)
set(CMAKE_CXX_STANDARD_COMPUTED_DEFAULT 17)
set(CMAKE_C_STANDARD_DEFAULT 17)
set(CMAKE_CXX_STANDARD_DEFAULT 17)
set(_s 98 11 14 17 20 23 26)
set(CMAKE_CXX_COMPILE_FEATURES "")
foreach(s ${_s})
  list(APPEND CMAKE_CXX_COMPILE_FEATURES cxx_std_${s})
  set(CMAKE_CXX${s}_COMPILE_FEATURES cxx_std_${s})
endforeach()
set(CMAKE_C_COMPILE_FEATURES "")
foreach(s 90 99 11 17 23)
  list(APPEND CMAKE_C_COMPILE_FEATURES c_std_${s})
  set(CMAKE_C${s}_COMPILE_FEATURES c_std_${s})
endforeach()
